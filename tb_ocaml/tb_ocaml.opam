opam-version: "2.0"
synopsis: "Prototype-grade OCaml compatibility build inspired by TigerBeetle"
description: "A prototype-grade OCaml rewrite of selected TigerBeetle-compatible surfaces for experimentation, learning, and focused comparison with parts of the upstream project."
maintainer: "tusharhqq"
authors: ["tusharhqq"]
dev-repo: "git+https://github.com/tusharhqq/6666.git"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.21"}
  "yojson"
  "base-unix"
  "base-threads"
  "odoc" {with-doc}
  "alcotest" {with-test}
  "qcheck" {with-test}
]
build: [
  ["dune" "build"]
]
