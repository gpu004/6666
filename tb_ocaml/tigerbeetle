#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h}"
TOOLS_DIR="$ROOT/_build_tools"
CHECKSUM_SRC="$ROOT/ocaml_tb_checksum.zig"
CHECKSUM_BIN="$TOOLS_DIR/tb_checksum"
MAIN_BIN="$ROOT/_build/default/bin/tigerbeetle.exe"
LOCAL_ZIG="$ROOT/../zig/zig"
ZIG_BIN="${ZIG_BIN:-}"

mkdir -p "$TOOLS_DIR"

if [[ -z "$ZIG_BIN" ]]; then
  if [[ -x "$LOCAL_ZIG" ]]; then
    ZIG_BIN="$LOCAL_ZIG"
  else
    ZIG_BIN="zig"
  fi
fi

if [[ "${1:-}" != "format" && "${1:-}" != "version" && "${1:-}" != "--help" && "${1:-}" != "inspect" ]]; then
  if [[ ! -x "$CHECKSUM_BIN" || "$CHECKSUM_SRC" -nt "$CHECKSUM_BIN" ]]; then
    "$ZIG_BIN" build --build-file "$ROOT/checksum_build.zig" -Doptimize=ReleaseFast --prefix "$TOOLS_DIR" >/dev/null
    cp "$TOOLS_DIR/bin/tb_checksum" "$CHECKSUM_BIN"
  fi
fi

if [[ ! -x "$MAIN_BIN" ]]; then
  dune build ./bin/tigerbeetle.exe
fi

export TB_OCAML_CHECKSUM_BIN="$CHECKSUM_BIN"
exec "$MAIN_BIN" "$@"
